* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}
html {
  scroll-behavior: smooth;
}
body {
  font-family: Arial, Helvetica, sans-serif;
  background: #050505;
  color: #ffffff;
  line-height: 1.6;
}
a {
  color: inherit;
  text-decoration: none;
}
button,
input {
  font: inherit;
}
/* HEADER */
.header {
  position: sticky;
  top: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 7%;
  background: rgba(5, 5, 5, 0.95);
  border-bottom: 1px solid #222;
  backdrop-filter: blur(10px);
}
.logo {
  font-size: 1.5rem;
  font-weight: 800;
  letter-spacing: 3px;
}
nav {
  display: flex;
  gap: 28px;
}
nav a {
  color: #bbb;
  transition: 0.2s;
}
nav a:hover {
  color: #fff;
}
.menu-btn {
  display: none;
  background: none;
  border: 0;
  color: #fff;
  font-size: 1.7rem;
  cursor: pointer;
}
/* HERO */
.hero {
  min-height: 80vh;
  display: flex;
  align-items: center;
  padding: 80px 7%;
  background:
    radial-gradient(circle at 80% 20%, #222 0, transparent 35%),
    #050505;
}
.hero-text {
  max-width: 750px;
}
.eyebrow {
  color: #999;
  font-size: 0.8rem;
  letter-spacing: 3px;
  margin-bottom: 15px;
}
.hero h1 {
  font-size: clamp(2.8rem, 8vw, 6rem);
  line-height: 1;
  margin-bottom: 25px;
}
.hero h1 span {
  color: #aaa;
}
.hero-text > p:not(.eyebrow) {
  max-width: 600px;
  color: #aaa;
  font-size: 1.1rem;
  margin-bottom: 35px;
}
.button {
  display: inline-block;
  padding: 14px 22px;
  background: #fff;
  color: #000;
  border-radius: 12px;
  font-weight: 700;
  transition: 0.2s;
}
.button:hover {
  transform: translateY(-2px);
  background: #ddd;
}
/* ASSISTENTE */
.assistant {
  max-width: 900px;
  margin: 0 auto;
  padding: 80px 7%;
  text-align: center;
}
.status {
  color: #aaa;
  margin-bottom: 12px;
  font-size: 0.9rem;
}
.assistant h2,
.features h2,
.about h2 {
  font-size: 2rem;
  margin-bottom: 25px;
}
.command-box {
  display: flex;
  gap: 10px;
  margin-top: 25px;
}
.command-box input {
  flex: 1;
  min-width: 0;
  padding: 15px;
  border: 1px solid #333;
  border-radius: 12px;
  outline: none;
  background: #111;
  color: #fff;
}
.command-box input:focus {
  border-color: #777;
}
.command-box button {
  padding: 0 22px;
  border: 0;
  border-radius: 12px;
  background: #fff;
  color: #000;
  font-weight: 700;
  cursor: pointer;
}
.quick-actions {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 15px;
}
.quick-actions button {
  padding: 10px 15px;
  border: 1px solid #333;
  border-radius: 999px;
  background: #101010;
  color: #ddd;
  cursor: pointer;
}
.quick-actions button:hover {
  background: #222;
}
.response {
  margin-top: 20px;
  min-height: 60px;
  padding: 18px;
  border: 1px solid #292929;
  border-radius: 15px;
  background: #0c0c0c;
  color: #ccc;
}
/* RECURSOS */
.features {
  padding: 80px 7%;
  max-width: 1200px;
  margin: auto;
  text-align: center;
}
.cards {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
}
.cards article {
  padding: 28px;
  min-height: 180px;
  text-align: left;
  border: 1px solid #292929;
  border-radius: 18px;
  background: #0c0c0c;
}
.cards h3 {
  margin-bottom: 10px;
}
.cards p {
  color: #999;
}
/* SOBRE */
.about {
  max-width: 800px;
  margin: auto;
  padding: 80px 7%;
  text-align: center;
}
.about p {
  color: #999;
}
/* FOOTER */
footer {
  padding: 35px 7%;
  border-top: 1px solid #222;
  color: #777;
  text-align: center;
}
/* CELULAR */
@media (max-width: 700px) {
  .header {
    padding: 16px 5%;
  }
  .menu-btn {
    display: block;
  }
  nav {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    display: none;
    flex-direction: column;
    gap: 0;
    background: #080808;
    border-bottom: 1px solid #222;
  }
  nav.open {
    display: flex;
  }
  nav a {
    padding: 16px 5%;
    border-top: 1px solid #222;
  }
  .hero {
    min-height: 75vh;
    padding: 70px 5%;
  }
  .hero h1 {
    font-size: 3.2rem;
  }
  .assistant,
  .features,
  .about {
    padding-left: 5%;
    padding-right: 5%;
  }
  .command-box {
    flex-direction: column;
  }
  .command-box button {
    min-height: 50px;
  }
  .cards {
    grid-template-columns: 1fr;
  }
}